{
  "_说明": "check_docs.ps1 的规则与例外。改规则先改这里；例外必须写 reason。路径均为仓库内相对路径，glob 按 / 分段匹配，** 结尾表示整个目录。检查范围只含机械一致性：链接/锚点/行内路径/索引/行数/路径卫生/数字口径/版本口径；散文与状态类事实（分类数、进度状态等）不机械检查，靠评审与 log。",
  "lineLimits": [
    { "pattern": "AGENTS.md", "limit": 60 },
    { "pattern": "README.md", "limit": 80 },
    { "pattern": "docs/README.md", "limit": 160 },
    { "pattern": "scripts/README.md", "limit": 90 },
    { "pattern": "docs/*.md", "limit": 320 },
    { "pattern": "submission/*.md", "limit": 600 }
  ],
  "redLineMax": 10,
  "index": {
    "docsRoot": { "index": "docs/README.md", "dir": "docs" },
    "log": { "index": "docs/log/README.md", "dir": "docs/log" },
    "requiredTopDirs": [ "docs", "pl", "ps", "scripts", "train", "pc", "submission" ]
  },
  "linkExceptions": [],
  "inlinePaths": {
    "_说明": "扫描行内代码 span 与围栏代码块里的仓内路径（只查 prefixes 前缀，避免误伤散文），Test-Path 校验；不存在的路径是 error。allowExact 用 path 字段、allowGlobs 用 glob 字段，每条必须写 reason（构建产物 / 运行期文件等）。",
    "prefixes": [ "scripts/" ],
    "excludeGlobs": [ "docs/log/**" ],
    "allowExact": [
      {
        "path": "scripts/boot/BOOT.bin",
        "reason": "构建产物：由 scripts/boot/make_bootbin.ps1 现场生成、不入库，命令块里出现属正常"
      },
      {
        "path": "scripts/boot/flash_log.txt",
        "reason": "打包脚本运行期写出的日志文件、不入库，命令说明里出现属正常"
      },
      {
        "path": "scripts/deploy/out/des_app",
        "reason": "编译产物：由 ps/ 编译后拷到 out/，二进制不入库（红线 3「入库边界」），命令块里出现是说明落点而非要求仓库里存在"
      }
    ],
    "allowGlobs": []
  },
  "pathHygiene": {
    "excludeGlobs": [ "docs/log/**" ],
    "exceptions": [
      {
        "file": "docs/环境与上手.md",
        "regex": "192\\.168\\.137\\.",
        "reason": "板端一次性固定 IP/网段（USB 网卡共享的默认配置），属环境前提；见 docs/README.md §写作约定「不写主机路径」第 4 条例外"
      },
      {
        "file": "docs/环境与上手.md",
        "regex": "255\\.255\\.255\\.0",
        "reason": "同上：USB 共享网卡的默认掩码"
      }
    ]
  },
  "keyNumbers": {
    "patterns": [ "99\\.31", "60\\.02fps", "3298\\.9", "7\\.85ms", "0\\.049227", "432122" ],
    "exemptGlobs": [ "docs/log/**", "submission/**", "README.md", "docs/测试与验证.md" ]
  },
  "claims": [
    {
      "name": "板端当前版本",
      "regex": "板端当前\\s*v(\\d+)",
      "expect": "16",
      "excludeGlobs": [ "docs/log/**" ]
    }
  ]
}
