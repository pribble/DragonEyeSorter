#!/bin/sh
# 自测用假 ssh：把板端绝对路径映射到 $FAKE_BOARD 下，输出再映射回板端路径（只覆盖 deploy.sh 用到的调用）
host=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o) shift 2 ;;
        -*) shift ;;
        *) host=$1; shift; break ;;
    esac
done
[ -n "$host" ] || { echo "fake ssh: no host" >&2; exit 255; }
map()   { sed "s#/root/#$FAKE_BOARD/root/#g; s#/tmp/desdeploy#$FAKE_BOARD/tmp/desdeploy#g"; }
unmap() { sed "s#$FAKE_BOARD/root/#/root/#g; s#$FAKE_BOARD/tmp/desdeploy#/tmp/desdeploy#g"; }
mkdir -p "$FAKE_BOARD/tmp"

if [ "$1" = sh ] && [ "$2" = -s ]; then
    shift 2
    map > "$FAKE_BOARD/tmp/remote.sh"
    [ $# -gt 0 ] || cp "$FAKE_BOARD/tmp/remote.sh" "$FAKE_BOARD/tmp/last-install.sh"   # 无参数 = 安装脚本，留档
    args=""
    for a in "$@"; do args="$args $(printf '%s' "$a" | map)"; done
    sh "$FAKE_BOARD/tmp/remote.sh" $args > "$FAKE_BOARD/tmp/remote.out"
    rc=$?
    unmap < "$FAKE_BOARD/tmp/remote.out"
    exit $rc
fi

cmd=$(printf '%s' "$*" | map)
case "$cmd" in
    *pidof*) exit 1 ;;   # 假板子上没有 des_app 在跑
esac
sh -c "$cmd"
