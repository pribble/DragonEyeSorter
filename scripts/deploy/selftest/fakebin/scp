#!/bin/sh
# 自测用假 scp：只支持 "scp [选项] <本地文件...> <host>:/tmp/desdeploy/"
while [ $# -gt 0 ]; do
    case "$1" in
        -o) shift 2 ;;
        -*) shift ;;
        *) break ;;
    esac
done
target=""
for a in "$@"; do target=$a; done
case "$target" in
    *:/tmp/desdeploy/) ;;
    *) echo "fake scp: unexpected target $target" >&2; exit 1 ;;
esac
mkdir -p "$FAKE_BOARD/tmp/desdeploy" || exit 1
n=0
for a in "$@"; do
    [ "$a" = "$target" ] && continue
    cp "$a" "$FAKE_BOARD/tmp/desdeploy/" || exit 1
    n=$((n + 1))
done
echo "fake scp: $n files -> $FAKE_BOARD/tmp/desdeploy" >&2
