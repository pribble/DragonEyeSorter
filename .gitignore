# 构建产物 / 大文件（见 AGENTS.md「大文件不入库」）
*.img
*.img.gz
BOOT.bin
# *.bit / *.hpf / *.elf 总体忽略；厂家底板与 boot 零件按 2026-10-09 决定白名单入库：
#   pl/soc_base/soc_prj.hpf（打开工程必需）
#   pl/soc_base/design_0/**（含 .v/.xml，无 .bit/.elf）
#   scripts/bootbin/parts/fsbl.elf、u-boot.elf（FSBL/U-Boot 不随 PL 重编而变）
*.bit
!pl/soc_base/**/*.bit
*.hpf
!pl/soc_base/*.hpf
*.elf
!scripts/bootbin/parts/fsbl.elf
!scripts/bootbin/parts/u-boot.elf
*.o
*.onnx
*.pt
*.zip
*.tar.gz
scripts/bootbin/parts/*
!scripts/bootbin/parts/fsbl.elf
!scripts/bootbin/parts/u-boot.elf
scripts/sd_image/flash_log.txt

ps/tools/desreg

# 安路 TD 工程产物
**/*_Runs/
**/.Xil/
*.log
*.logw
*.db
*.timing
*.rpt
*.area
*.ts
*.qor
.*.f

# FD / Eclipse 工作区
.metadata/
**/build/

# 数据集
datasets/
models/runs/

# 编辑器 / 系统
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
System Volume Information/

# 本机参考底板（仓库外，见 docs/10）
/reference_src/

# 本机环境配置（包含硬编码路径，不要提交）
.env
.env.local
.env.make
