# des.env —— 板端路径的唯一来源。板上所有 .sh 与 des_app 都从这里取路径，代码里不写死。
#
# 谁怎么用它（三段，谁都不许再写死绝对路径）：
#   脚本（.sh）：先算出自己所在目录，再 source 本文件 ——
#       SELF=$(readlink -f -- "$0" 2>/dev/null || echo "$0")
#       DES_HOME=${DES_HOME:-$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)}
#       . "$DES_HOME/des.env"
#   程序（des_app）：不读本文件，只读**本文件 export 出去的同名环境变量**（经 des_app.sh source 后就有）。
#   交互查看：先 cd 到本文件所在目录再 `. ./des.env`（交互 shell 里 DES_HOME 用当前目录兜底）。
#
# 规矩：
#   · 本目录自己的路径全部由 DES_HOME 派生 —— 整份目录拷到别处部署（deploy --dest）就跟着走，
#     所以这里一个写死的本目录绝对路径都没有；
#   · 厂家 / 系统 / 全板共用的东西（相机驱动、调试与测试工具）是跨目录的，就按绝对路径登记在这里，
#     换镜像 / 换板子时只改这一处；
#   · 每个变量都可先 export 覆盖，特殊场景要指到别处时不用改脚本。
#
# 注：des_app 的记录 CSV 不在这儿定义 —— 它读 des_app.json 的 storage.dir，缺省 data/log，
#     按配置所在目录解析，等价于下面的 $DES_DATA/log（生产与测试目录各自落各自的）。

# ---- 本目录与数据（由脚本注入 DES_HOME；没有注入时按当前目录兜底）----
DES_HOME=${DES_HOME:-$(pwd)}
DES_DATA=${DES_DATA:-$DES_HOME/data}

# ---- 程序与配置 ----
DES_APP=${DES_APP:-$DES_HOME/des_app}
DES_CONFIG=${DES_CONFIG:-$DES_HOME/des_app.json}          # des_app 不带 -c 时的缺省

# ---- 自启服务（des_service.sh 用）----
DES_AUTOSTART_CONF=${DES_AUTOSTART_CONF:-$DES_HOME/autostart.conf}
DES_SERVICE_LOG=${DES_SERVICE_LOG:-$DES_DATA/service.log}
DES_PIDF=${DES_PIDF:-$DES_DATA/des_service.pid}           # 每份目录一个 PID 文件，两份服务不打架

# ---- 数据 ----
DES_COLLECT=${DES_COLLECT:-$DES_DATA/collect}             # des_app collect 采训练图（des_app 读它）

# ---- 全板共用的工具与厂家件（跨目录，绝对值登记在此）----
DES_TOOLS=${DES_TOOLS:-/root/bin}                         # 手动上板的测试 / 调试程序（test_*、desreg、canplc）
DES_MIPICAM_KO=${DES_MIPICAM_KO:-/opt/bin/mipicam.ko}     # 厂家相机驱动（des_app.sh 缺模块时 insmod）

export DES_HOME DES_DATA DES_APP DES_CONFIG DES_AUTOSTART_CONF \
       DES_SERVICE_LOG DES_PIDF DES_COLLECT DES_TOOLS DES_MIPICAM_KO
