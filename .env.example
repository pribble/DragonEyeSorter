# DragonEyeSorter 环境配置文件示例
# 用法：把本文件复制为仓库根的 .env，填上你本机的路径（.env 不入库，见 .gitignore）
#   Windows:  copy .env.example .env         WSL/Linux:  cp .env.example .env
# 路径格式：<盘符>:/目录 或 <盘符>:\目录 都可以；WSL 下也可写 /mnt/<盘符小写>/... 或 $HOME/...
# 各变量指向什么、怎么获取，见 docs/环境配置指南.md；填完自检：scripts/test_env.ps1
# 下面的占位符都要替换掉，留成"请填写…"会让脚本报"路径不存在"

# ===== 工具链路径 =====
# FD（飞龙嵌入式开发工具）安装目录，内含 toolchain/gcc/aarch64_linux/
FD_ROOT=请填写FD安装目录

# TD（Tang Dynasty FPGA 工具，6.2.1）安装目录，内含 license/ 与 bin/
TD_ROOT=请填写TD安装目录

# ===== 厂家资料（自行获取，不入库）=====
# NPU demo 解压目录，内含 boot/、soc_sdk/、soc_prj/
NPU_DEMO=请填写NPU_Demo解压目录

# 厂家 face_detection demo 的 libs 目录，内含 armnn_lib/ 与 ffmpeg_opencv4.7.0_aarch64/
SDK_LIBS=请填写face_detection的libs目录

# FreeType 头文件目录（HDMI 界面中文显示用；从板上拷或从官网源码包取，见 docs/开发环境与构建.md）
FREETYPE_INC=请填写FreeType头文件目录

# 板上库文件的本地拷贝目录（libfreetype.so.6 等，从板上 scp 下来）
BOARD_LIBS=请填写板上库本地目录

# ===== 训练环境（WSL）=====
DES_TRAIN_VENV=$HOME/des-train
DES_WORK_DIR=$HOME/des-work

# ===== 板卡连接 =====
BOARD_IP=192.168.137.100
SSH_KEY=$HOME/.ssh/id_ed25519_anlu
