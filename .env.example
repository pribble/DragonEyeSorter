# DragonEyeSorter 环境配置文件示例
# 拷贝此文件为 .env 并填入你本机的实际路径
# 注意：.env 文件不会被提交到 git（已在 .gitignore 中）

# ===== 工具链路径 =====
# FD (飞龙嵌入式开发工具) 安装目录
FD_ROOT=C:/Anlogic/FD_2026.1_SP1

# TD (Tang Dynasty FPGA 工具) 安装目录
TD_ROOT=C:/Anlogic/TD_Release_6.2.1

# ===== 厂家资源路径 =====
# NPU Demo 完整解压路径（包含 boot/soc_sdk/soc_prj 等目录）
NPU_DEMO=D:/ANLU/02_F3P_DR1M90GEG400/01_start/02_start_Linux/05_application_demo/05-5_NPU演示/demo

# ===== PS 开发所需 SDK =====
# 厂家 face_detection demo 的 libs 目录（包含 armnn_lib 和 ffmpeg_opencv4.7.0_aarch64）
SDK_LIBS=D:/ANLU/work/face_detection_src/app/face_detection/libs

# FreeType 头文件目录（用于 HDMI 界面中文显示）
FREETYPE_INC=D:/ANLU/work/freetype2_include

# 板上库文件本地拷贝（libfreetype.so.6 等）
BOARD_LIBS=D:/ANLU/work/board_libs

# ===== 训练环境 =====
# WSL 中的 Python 虚拟环境路径
DES_TRAIN_VENV=$HOME/des-train

# 训练工作目录（数据集、模型输出等）
DES_WORK_DIR=$HOME/des-work

# ===== 板子连接信息 =====
# 板子 IP 地址
BOARD_IP=192.168.137.100

# SSH 密钥路径
SSH_KEY=$HOME/.ssh/id_ed25519_anlu

# ===== 项目路径 (WSL) =====
# 本项目在 WSL 中的挂载路径
PROJECT_WSL_PATH=/mnt/c/Users/11691/Anlogic/DragonEyeSorter
